# aws_region defaults to ap-south-1 — override only if this environment ever needs to differ.
#
# No required values. The former nlb_allowed_cidrs (Cloudflare edge ranges for the EKS NLB) was
# removed with the EKS topology: the Production ALB is the public, AWS WAF-protected edge
# (ADR-004 as amended), so its ingress is 0.0.0.0/0 and set in main.tf.

# Optional — GuardDuty/Security Hub finding notifications.
# security_finding_notification_emails = ["<on-call distribution list>"]
