# Local Terraform working state — never committed, regenerated by `terraform init`
**/.terraform/
.terraform/

# State files and their backups — remote (S3) state is the source of truth; a local .tfstate
# appearing here at all means someone ran init without the S3 backend configured, which is itself
# a signal something is wrong, not just a file to hide
*.tfstate
*.tfstate.*
*.tfstate.backup

# Plan output files — may contain sensitive values in the plan diff, never committed
*.tfplan
*.plan

# Real variable files — only *.tfvars.example is committed; a real one contains environment-
# specific values that, even when non-secret, don't belong in Git (Section 6, platform-standards.md)
*.tfvars
!*.tfvars.example

# Crash logs
crash.log
crash.*.log

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# override files (local, developer-specific overrides — never committed by design)
override.tf
override.tf.json
*_override.tf
*_override.tf.json
