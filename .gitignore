# Local Terraform working state — never committed, regenerated by `terraform init`
**/.terraform/
.terraform/

# State files and their backups — remote (S3) state is the source of truth; a local .tfstate
# appearing here at all means someone ran init without the S3 backend configured, which is itself
# a signal something is wrong, not just a file to hide
*.tfstate
*.tfstate.*
*.tfstate.backup

# Plan output files — may contain sensitive values in the plan diff, never committed
*.tfplan
*.tfplan.*
*.plan

# Terraform run captures (plan/apply output saved as text) — local audit evidence, archived
# outside the repository; they carry account IDs, ARNs and resource IDs
environments/**/*-plan*.txt
environments/**/*-apply*.txt
environments/**/*-run.txt
environments/**/destroy-list*.txt

# Lifecycle run logs (docs/production-lifecycle.md, safety requirement 10)
logs/
*.log

# Real variable files — only *.tfvars.example is committed; a real one contains environment-
# specific values that, even when non-secret, don't belong in Git (Section 6, platform-standards.md)
*.tfvars
!*.tfvars.example
# Exception: each Production layer's operating mode is committed on purpose, so a lifecycle
# change (idle/build/live) is a reviewed Git change - docs/production-lifecycle.md.
!environments/production/**/operating-mode.auto.tfvars
!environments/production/operating-mode.auto.tfvars
# Exception: the Production API rate limit (normally 100; temporarily raised only for a load test)
# is committed for the same reason — the active value must always be visible in Git.
!environments/production/app/rate-limit.auto.tfvars

# Crash logs
crash.log
crash.*.log

# Local environment files and key material — never committed
.env
.env.*
!.env.example
*.pem
*.key

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# override files (local, developer-specific overrides — never committed by design)
override.tf
override.tf.json
*_override.tf
*_override.tf.json
